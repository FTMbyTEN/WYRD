# runtime state — user accounts, sessions, memory, chat history, learned data.
# not source code, and some of it is sensitive (password hashes, session tokens).
# qa_datasets.json/dialogue_datasets.json are tracked on purpose (see below) — everything
# else in data/ is excluded individually so new runtime files stay ignored by default.
data/access.json
data/conversations.json
data/lexicon.json
data/memory.json
data/mind.json
data/sessions.json
