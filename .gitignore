data/self_config.json
data/cop_log.json
data/self_code_edits.json
data/curriculum.json
data/datasets/
data/photos/
data/*.tmp

# generated reasoning trace files (thousands of small .md files)
reasoning/

# build artifacts (APK/web export/EAS metadata) — large binaries, not source
mobile/*.apk
mobile/*-bundle.zip
mobile/eas_build_info.json
